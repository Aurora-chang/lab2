{
  "experiment_name": "deepconvnet_elu_lr0005_seed42",
  "seed": 42,
  "data_dir": "lab2_EEG_classification/data",
  "output_dir": "outputs",
  "model": {
    "name": "DeepConvNet",
    "activation": "elu",
    "elu_alpha": 1.0,
    "negative_slope": 0.01,
    "dropout": 0.5,
    "conv_max_norm": 2.0,
    "classifier_max_norm": 0.5
  },
  "training": {
    "epochs": 150,
    "batch_size": 64,
    "learning_rate": 0.0005,
    "optimizer": "adam",
    "weight_decay": 0.001,
    "loss": "cross_entropy",
    "artifact_interval": 25
  },
  "evaluation": {
    "validation_fraction": 0.2,
    "stratify": true,
    "checkpoint_metric": "validation_accuracy",
    "record_test_curves": true,
    "split_seed": 42
  }
}
